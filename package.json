{
    "name": "root",
    "version": "4.0.0",
    "private": true,
    "workspaces": [
        "src/modules/*",
        "src/extensions/*"
    ],
    "scripts": {
        "watch": "node build watch",
        "build": "node build build",
        "test": "jest",
        "coverage": "jest --coverage",
        "typecheck": "yarn typecheck-core-src && yarn typecheck-core-app && yarn typecheck-core-renderer && yarn typecheck-rjsf && yarn typecheck-vscode-browser",
        "typecheck-core-src": "tsc --noEmit -p src/extensions/core/src/tsconfig.json",
        "typecheck-core-app": "tsc --noEmit -p src/extensions/core/app/tsconfig.json",
        "typecheck-core-renderer": "tsc --noEmit -p src/extensions/core/renderer/tsconfig.json",
        "typecheck-rjsf": "tsc --noEmit -p src/modules/rjsf/tsconfig.json",
        "typecheck-vscode-browser": "tsc --noEmit -p src/modules/vscode/browser/tsconfig.json",
        "lint": "NODE_OPTIONS=\"--max-old-space-size=8192\" yarn eslint .",
        "ci:coverage": "jest --coverage --coverageReporters=cobertura",
        "clean": "sh -c 'cd src/extensions/${0} && yarn clean'",
        "proto-go-yamcs": "sh internal/yamcspb/generate.sh",
        "proto-js": "pbjs -t static-module -w commonjs -o src/modules/types/src/proto/index.js proto/pb/*.proto",
        "proto-ts": "pbjs -t static-module proto/pb/*.proto | pbts -o src/modules/types/src/proto/index.d.ts -",
        "proto-ts-yamcs": "yarn proto-loader-gen-types -I=proto --grpcLib=@grpc/grpc-js --longs=String --enums=String --outDir=src/modules/rpc/src/proto/yamcs yamcs/protobuf/processing/processing.proto yamcs/protobuf/events/events_service.proto yamcs/protobuf/commanding/commands_service.proto yamcs/protobuf/instances/instances_service.proto yamcs/protobuf/buckets/buckets.proto yamcs/protobuf/filetransfer/filetransfer.proto",
        "proto-json-yamcs": "yarn pbjs -p=proto -t json proto/yamcs/protobuf/processing/processing.proto proto/yamcs/protobuf/events/events_service.proto proto/yamcs/protobuf/commanding/commands_service.proto proto/yamcs/protobuf/instances/instances_service.proto proto/yamcs/protobuf/buckets/buckets.proto proto/yamcs/protobuf/filetransfer/filetransfer.proto -o src/modules/rpc/src/proto/yamcs.json",
        "proto": "npm run proto-js && npm run proto-ts && npm run proto-ts-yamcs && npm run proto-json-yamcs",
        "package": "sh -c 'cd src/extensions/${0} && yarn package'",
        "package-all": "yarn package core && yarn package fprime",
        "build-save-dictionaries": "esbuild src/extensions/core/src/saveDictionaries.ts --bundle --platform=node --log-level=warning --outfile=out/save-dictionaries.js",
        "save-dictionaries": "yarn -s build-save-dictionaries && node out/save-dictionaries.js",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@eslint/compat": "^1.1.0",
        "globals": "^17.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@hyrious/esbuild-plugin-style": "^0.3.5",
        "@jest/globals": "^29.7.0",
        "@types/jest": "^30.0.0",
        "@types/vscode": "^1.99.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vscode/test-electron": "^2.2.0",
        "async": "^3.2.4",
        "esbuild": "0.28.2",
        "esbuild-css-modules-plugin": "^3.1.5",
        "esbuild-sass-plugin": "^3.2.0",
        "eslint": "^10.10.0",
        "eslint-formatter-checkstyle": "^9.0.1",
        "jest": "^30.5.1",
        "jest-text-transformer": "^1.0.4",
        "patch-package": "^8.0.0",
        "protobufjs": "^7.6.5",
        "protobufjs-cli": "1.1.3",
        "sass-embedded": "^1.71.1",
        "tmp": "^0.2.1",
        "ts-jest": "^29.4.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0"
    }
}
