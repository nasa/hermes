{
    "type": "object",
    "description": "Bridge an F Prime/CCSDS connection over any socat transport (serial, TLS, UDP, SSH, PTY, TCP)",
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the FSW once a connection is made"
        },
        "address": {
            "type": "string",
            "title": "Socat Address",
            "description": "socat far-side address, e.g. 'TCP:localhost:8000' or '/dev/ttyUSB0,b115200,raw'"
        },
        "dictionary": {
            "type": "string",
            "description": "FPrime dictionary to send/receive data with"
        },
        "protocol": {
            "type": "string",
            "title": "Protocol",
            "default": "ccsds",
            "description": "Framing protocol to communicate over",
            "enum": [
                "fprime",
                "ccsds"
            ]
        }
    },
    "required": [
        "address"
    ]
}
